{
  "name": "memefish-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run build:wasm && npm run dev:ui",
    "dev:ui": "vite",
    "build": "npm run build:wasm:verified && npm run build:ui",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:verified": "node scripts/build-wasm.mjs --vulncheck",
    "build:ui": "vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:ui": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "preact": "~10.29.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "24.13.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "~8.1.5",
    "vitest": "~4.1.10"
  }
}
